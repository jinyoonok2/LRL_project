# Pick/PnP expansion run for MolmoBot-RBY1Multitask.
#
# Usage:
#   RBY1_EVAL_CONFIG=configs/rby1_pick_pnp_expansion.env \
#     bash scripts/prepare_rby1_benchmark_assets.sh
#   RBY1_EVAL_CONFIG=configs/rby1_pick_pnp_expansion.env \
#     bash scripts/run_rby1_multitask_eval.sh all all

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$CONFIG_DIR/rby1_eval.env"

DEFAULT_TASKS=(pick pnp)
DEFAULT_INDICES=(
  10 21 33 56 58 74 99 101 123 137
  155 158 171 199 206 224 230 255 268 279
  291 304 318 334 354 361 384 388 413 420
  438 447 470 472 488 504 521 533 546 566
  578 589 600 619 640 649 661 682 687 713
  715 729 748 758 782 795 804 821 829 845
  866 872 892 900 921 942 947 961 974 986
)

DEFAULT_OUTPUT_BASE_DIR="$PROJECT_ROOT/MolmoBot/MolmoBot/eval_output"
